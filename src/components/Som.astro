---
import { Image } from 'astro:assets';
import { musicas, videos, spotifyArtistaId, redes } from '../data/banda';
import posterAlgo from '../assets/fotos/show-paim.jpg';
import posterAnimal from '../assets/fotos/show-jpeg.jpg';
import Icone from './Icone.astro';

const posters: Record<string, ImageMetadata> = {
  OY0fS3AOQDw: posterAlgo,
  soFQTg9EfDw: posterAnimal,
};
const spotify = redes.find((r) => r.icone === 'spotify')!;
const youtube = redes.find((r) => r.icone === 'youtube')!;
---
<section class="section som" id="som" aria-labelledby="titulo-som">
  <div class="wrap som__ouca">
    <div class="som__intro">
      <h2 id="titulo-som" class="display h2" data-reveal>Ouça</h2>
      <ol class="som__faixas">
        {musicas.map((m, i) => (
          <li data-reveal style={`--i:${i + 1}`}>
            <span class="som__num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="display som__faixa">{m.titulo}</p>
              <p class="som__meta">Single, {m.lancamento.toLowerCase()}. Produção {m.producao}.</p>
            </div>
          </li>
        ))}
      </ol>
      <a class="btn btn--ghost" href={spotify.url} target="_blank" rel="noopener" data-reveal style="--i:3">
        <Icone nome="spotify" tamanho={18} /> Abrir no Spotify
      </a>
    </div>
    <div class="som__player" data-reveal style="--i:1">
      <iframe
        title="Contra Cultura no Spotify"
        src={`https://open.spotify.com/embed/artist/${spotifyArtistaId}?utm_source=generator&theme=0`}
        width="100%"
        height="452"
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      ></iframe>
    </div>
  </div>

  <div class="wrap som__assista">
    <h2 class="display h2" data-reveal>Assista</h2>
    <div class="som__videos">
      {videos.map((v, i) => (
        <figure class="video" data-reveal style={`--i:${i}`}>
          <button class="video__capa" type="button" data-youtube={v.youtubeId} data-titulo={v.titulo} aria-label={`Assistir ao clipe de ${v.titulo}`}>
            <Image src={posters[v.youtubeId]} alt="" widths={[640, 960, 1400]} sizes="(max-width: 760px) 100vw, 60vw" />
            <span class="video__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
            </span>
          </button>
          <figcaption>
            <span class="display video__titulo">{v.titulo}</span>
            <span class="video__tipo">Clipe oficial</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <a class="som__canal" href={youtube.url} target="_blank" rel="noopener" data-reveal>
      <Icone nome="youtube" tamanho={20} /> Ver o canal no YouTube
    </a>
  </div>
</section>

<style>
  .som__ouca {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .som__intro { display: grid; gap: 36px; justify-items: start; }
  .som__faixas { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; width: 100%; }
  .som__faixas li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 20px;
    align-items: baseline;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .som__num { font-family: var(--font-mono); font-size: 14px; color: var(--accent); }
  .som__faixa { font-size: clamp(36px, 4vw, 60px); }
  .som__meta { color: var(--muted); font-size: 15px; margin-top: 6px; }
  .som__player {
    min-width: 0;
    background: var(--surface);
    min-height: 452px;
  }
  .som__player iframe { border: 0; width: 100%; }

  .som__assista { margin-top: clamp(96px, 12vw, 180px); display: grid; gap: clamp(32px, 4vw, 56px); }
  .som__videos {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(16px, 2vw, 28px);
    align-items: start;
  }
  .video:nth-child(2) { margin-top: clamp(0px, 12vw, 180px); }
  .video { margin: 0; display: grid; gap: 16px; min-width: 0; }
  .video__capa {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    background: #000;
    cursor: pointer;
    overflow: hidden;
  }
  .video__capa :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.82;
    transition: transform 1.2s var(--ease-out), opacity 0.4s;
  }
  .video__capa:hover :global(img) { transform: scale(1.04); opacity: 1; }
  .video__play {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: #fff;
    transition: transform 0.4s var(--ease-out);
  }
  .video__capa:hover .video__play { transform: scale(1.08); }
  .video :global(iframe) { width: 100%; aspect-ratio: 16 / 9; height: auto; border: 0; }
  .video figcaption { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .video__titulo { font-size: clamp(28px, 2.6vw, 40px); }
  .video__tipo { color: var(--muted); font-size: 14px; white-space: nowrap; }
  .som__canal {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    text-decoration: none;
    width: fit-content;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 4px;
  }
  .som__canal:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .som__ouca { grid-template-columns: 1fr; }
    .som__videos { grid-template-columns: 1fr; }
    .video:nth-child(2) { margin-top: 0; }
  }
</style>
