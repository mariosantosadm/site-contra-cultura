---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { lugares } from '../data/banda';
import setaEsq from '@phosphor-icons/core/assets/bold/arrow-left-bold.svg?raw';
import setaDir from '@phosphor-icons/core/assets/bold/arrow-right-bold.svg?raw';
---
<section class="lugares" id="lugares" aria-labelledby="titulo-lugares" data-lugares>
  <div class="lugares__fixo" data-lugares-fixo>
    <div class="wrap lugares__cabeca">
      <div class="lugares__titulos">
        <h2 id="titulo-lugares" class="display h2" data-reveal>Onde já tocamos</h2>
        <p class="lede lugares__lede" data-reveal style="--i:1">
          Diferentes palcos. A mesma intensidade. A energia nunca muda.
        </p>
      </div>
      <div class="lugares__setas" data-reveal style="--i:2">
        <button class="seta" type="button" data-lugares-ant aria-label="Lugar anterior" aria-controls="trilho-lugares" disabled>
          <Fragment set:html={setaEsq} />
        </button>
        <button class="seta" type="button" data-lugares-prox aria-label="Próximo lugar" aria-controls="trilho-lugares">
          <Fragment set:html={setaDir} />
        </button>
      </div>
    </div>

    <div class="lugares__janela">
      <ol class="lugares__trilho" id="trilho-lugares" data-lugares-trilho>
        {lugares.map((l, i) => (
          <li class:list={['lugar', { 'lugar--sem-foto': !l.foto }]} style={`--ratio:${l.foto ? (l.foto.width / l.foto.height).toFixed(4) : '0.8'}`} data-lugar>
            <figure class="lugar__foto">
              {l.foto ? (
                <Image src={l.foto} alt={`Contra Cultura no ${l.nome}`} widths={[480, 800, 1200]} sizes="(max-width: 899px) 86vw, 60vw" />
              ) : (
                <div class="lugar__placa" aria-hidden="true">
                  <Image src={logo} alt="" width={160} height={160} />
                </div>
              )}
            </figure>
            <div class="lugar__texto">
              <h3 class="display lugar__nome">{l.nome}</h3>
              {l.descricao && <p class="lugar__descricao">{l.descricao}</p>}
              {l.link && <a class="lugar__link" href={l.link} target="_blank" rel="noopener">Ver o show</a>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .lugares { padding-top: clamp(32px, 6vw, 80px); }
  .lugares__fixo {
    min-height: 100svh;
    padding-top: calc(var(--nav-h) + env(safe-area-inset-top, 0px) + 24px);
    padding-bottom: 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(32px, 4vw, 56px);
  }
  .lugares__cabeca {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 40px;
  }
  .lugares__titulos { display: grid; gap: 20px; }
  .lugares__lede { max-width: 62ch; }

  .lugares__setas { display: flex; gap: 10px; }
  .seta {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 2px solid var(--ink);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.25s var(--ease-out), color 0.25s var(--ease-out), border-color 0.25s var(--ease-out), opacity 0.25s, transform 0.15s var(--ease-out);
  }
  .seta :global(svg) { width: 22px; height: 22px; }
  @media (hover: hover) {
    .seta:hover:not(:disabled) { background: var(--accent); border-color: var(--accent); color: #fff; }
  }
  .seta:active:not(:disabled) { transform: scale(0.96); }
  .seta:disabled { opacity: 0.3; cursor: default; }

  .lugares__janela { overflow: hidden; }
  .lugares__trilho {
    list-style: none;
    margin: 0;
    display: flex;
    align-items: flex-start;
    gap: clamp(16px, 2vw, 28px);
    padding-left: max(var(--gutter), env(safe-area-inset-left, 0px), calc((100vw - var(--max)) / 2 + var(--gutter)));
    padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
    width: max-content;
  }

  /* Todas as fotos com a mesma altura e cada uma no formato original, sem corte.
     A altura acompanha a tela para o cartão inteiro caber enquanto a seção fica presa. */
  .lugar {
    --altura: clamp(220px, calc(100svh - 400px), 520px);
    width: calc(var(--altura) * var(--ratio));
    flex-shrink: 0;
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .lugar__foto {
    margin: 0;
    width: 100%;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--surface);
  }
  .lugar__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .lugar:hover .lugar__foto :global(img) { transform: scale(1.03); }

  .lugar__placa {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--accent) 55%, transparent), transparent 60%),
      radial-gradient(circle at 85% 90%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 50%),
      var(--surface);
  }
  .lugar__placa :global(img) { width: 38%; height: auto; opacity: 0.95; }

  .lugar__nome {
    font-size: clamp(28px, min(3vw, 4.6vh), 48px);
    margin-top: 4px;
  }
  .lugar__descricao { color: var(--muted); margin-top: 10px; max-width: 36ch; }
  .lugar__link { display: inline-block; margin-top: 10px; font-weight: 600; }

  /* Celular: rolagem lateral com o dedo ou pelas setas, encaixando foto a foto */
  @media (max-width: 899px) {
    .lugares__fixo { min-height: 0; padding-top: 0; padding-bottom: 0; }
    .lugares__setas { margin-left: auto; }
    .seta { width: 48px; height: 48px; }
    .lugares__janela {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
    }
    .lugares__janela::-webkit-scrollbar { display: none; }
    .lugar {
      --altura: min(58vw, 340px);
      max-width: 86vw;
      scroll-snap-align: start;
      scroll-margin-left: var(--gutter);
    }
  }
</style>
